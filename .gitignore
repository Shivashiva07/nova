venv/

# Personal data: chats, memories, notes, reminders
nova_memory.db
nova_memory.db-*
nova_memory.backup-*.db
nova_memory.backup-*.db-*
nova_memory.damaged-*.db*
backups/
*.novabackup
*.db-wal
*.db-shm

# Per-machine settings written by the app (defaults are built in),
